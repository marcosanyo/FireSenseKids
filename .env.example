# ==============================================================================
# FireSense Kids — environment
# ==============================================================================

# AWS (deploy + Bedrock). us-east-1 only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only with temporary credentials (AWS SSO / STS):
# AWS_SESSION_TOKEN=

# The only AI model: Claude Sonnet 4.6 on Amazon Bedrock (US cross-region inference profile).
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Build-time endpoints for the static export (from `terraform output`; scripts/deploy.sh sets them).
# The build fails if any is missing.
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WEB_ORIGIN=

# Cost controls (terraform; required, no defaults — `make deploy` fails until both are set).
# AWS Budgets e-mails this address at 80% of actual and 100% of forecast monthly cost.
TF_VAR_monthly_budget_usd=
TF_VAR_budget_alert_email=
# Optional: max Bedrock calls (weekly report) per pairing session per UTC day (default 30).
# TF_VAR_report_daily_limit=30
